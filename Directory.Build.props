<Project>

  <PropertyGroup Label="Compiler">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Company>holonsoft</Company>
    <Authors>Christian Vogt</Authors>
    <Copyright>Christian Vogt, holonsoft</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/holonsoft/CmdLineParser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/holonsoft/CmdLineParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>commandline;cmdline;parser;arguments;cli;poco;reflection</PackageTags>
    <PackageReleaseNotes>5.0.0: Properties, nullable types, dictionaries and many more member types; custom converters; ParseArguments with structured errors; all ArgumentTypes flags and the default argument implemented; validation attributes and IValidatableArguments; verbs (VerbParser); response files; environment variable fallback; exclusive groups; aliases; hidden and categorized help, usage line, description; completion scripts for bash, zsh and PowerShell; message formatter; trim and AOT annotations. See README for breaking changes.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Label="Package build">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup Label="Versioning">
    <!-- MinVer derives the version from git tags (v5.0.0). Untagged commits become 5.0.x-preview.0.N. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>5.0</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
